# Set true only for an explicitly disposable sample workspace.
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Activate only providers configured in Supabase, e.g. google,github.
# Unconfigured providers remain visible but disabled on login and signup.
NEXT_PUBLIC_AUTH_PROVIDERS=
# Server-only OAuth credentials for local Supabase. See docs/social-sign-in.md.
# Google/GitHub: OAuth client ID + client secret; Apple: Services ID + signed JWT.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Back up securely. Changing this value makes existing ciphertext unreadable.
ENCRYPTION_KEY=

# Optional reminder service (all four values required to send).
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
APP_URL=http://localhost:3000
